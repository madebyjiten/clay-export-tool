# --- Core ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
INGEST_API_KEY=change-me-optional
REQUEST_TIMEOUT=30
MAX_BATCH_SIZE=1000
EXPORT_MAX_ROWS=50000

# --- Optional: forward stored rows to another API via POST /push ---
DESTINATION_API_URL=
DESTINATION_API_KEY=

# --- Google Sheets mirror ---
# One spreadsheet. Each distinct Clay batch_name becomes its own tab in it,
# rebuilt from Postgres after every ingest. Rows with no batch_name go to the
# UNGROUPED_TAB tab.
GOOGLE_SA_JSON={"type":"service_account","project_id":"...","private_key":"..."}
SHEET_ID=1AbCdEf_the_id_from_the_spreadsheet_url
UNGROUPED_TAB=ungrouped
# Auto-rebuild the affected tab(s) after each ingest. Default on.
SYNC_ON_INGEST=true
# Settle delay (seconds) before each rebuild, so a burst of chunks for one
# export collapses into a single write.
SHEET_SYNC_SETTLE_SECONDS=3
