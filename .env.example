# --- Core ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
INGEST_API_KEY=change-me-optional
REQUEST_TIMEOUT=30
MAX_BATCH_SIZE=1000
EXPORT_MAX_ROWS=50000

# --- Optional: forward stored rows to another API via POST /push ---
DESTINATION_API_URL=
DESTINATION_API_KEY=

# --- Google Sheets mirror ---
# Paste the FULL service-account JSON key on one line (or as a Railway multiline var).
GOOGLE_SA_JSON={"type":"service_account","project_id":"...","private_key":"..."}
SHEET_ID=1AbCdEf_the_id_from_the_sheet_url
SHEET_TAB=Leads
# Refresh the sheet automatically after each ingest (debounced). Leave blank to
# rely on POST /sync-sheets (recommended: call it from a Railway cron).
SYNC_ON_INGEST=
SHEET_SYNC_MIN_INTERVAL=15
